{
	"name": "pizza",
	"compatibility_date": "2026-10-12",
	"assets": {
		"directory": "./dist"
	},
	"vars": {
		"ENVIRONMENT": "production"
	},
	"r2_buckets": [
		{
			"binding": "UPLOADS",
			"bucket_name": "prod-uploads"
		}
	],
	"previews": {
		"vars": {
			"ENVIRONMENT": "preview"
		},
		"r2_buckets": [
			{
				"binding": "UPLOADS",
				"bucket_name": "r2-staging"
			}
		]
	},
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "d31d8a3c9d5c4859991a460c373013fc",
			"remote": true
		}
	]
}