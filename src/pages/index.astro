---
import Baselayout from "../layouts/baselayout.astro";
import { business } from "../config/business.json";
import { dataUrls } from "../constants/constants";
const title = dataUrls.home.name;
---

<Baselayout>
  <section>
    <h1>{title}</h1>
    <p>{business.name}</p>
    <div>
      <input id="classful" class="field" placeholder="name" type="text" />
      <button id="prototype">post</button>
    </div>
  </section>
</Baselayout>
