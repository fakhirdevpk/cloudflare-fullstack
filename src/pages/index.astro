---
import Baselayout from "../layouts/baselayout.astro";
import { business } from "../config/business.json";
import { dataUrls } from "../constants/constants";

import A from "../components/link-button.astro";
import B from "../components/link-chip.astro";
import C from "../components/link-text-block.astro;

const title = dataUrls.home.name;
---

<Baselayout>
  <section>
    <h1>{title}</h1>
    <p>{business.name}</p>
    <A client:load />

  </section>
</Baselayout>
